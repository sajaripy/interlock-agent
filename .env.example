# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Everything here has a working local default
# except ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-opus-5
MAX_TOKENS=16000

# --- Postgres --------------------------------------------------------------
# Used for BOTH the LangGraph checkpointer (via psycopg) and the application
# tables (via SQLAlchemy + asyncpg). Matches docker-compose.yml.
POSTGRES_DSN=postgresql://interlock:interlock@localhost:5432/interlock

# Optional override for the SQLAlchemy application database only.
# Leave unset in production; tests set it to sqlite+aiosqlite.
# APP_DB_URL=sqlite+aiosqlite:///./interlock.db

# --- Mailpit (fake SMTP; see docker-compose.yml) ----------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=agent@interlock.local

# --- Policy ----------------------------------------------------------------
POLICY_PATH=policy.yaml

# --- Observability (optional; omit to disable tracing) ----------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000

# --- HTTP tool guardrails --------------------------------------------------
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_BYTES=20000
